# Example environment variables for bitcoinforthearts.org
# Copy to `.env.local` for local dev (DO NOT commit secrets).

# --- Core ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=bitcoinforthearts

# --- Admin (Basic Auth for /admin/*) ---
ADMIN_USER=change-me
ADMIN_PASS=change-me

# --- Resend (recommended email provider) ---
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=hello@bitcoinforthearts.org

# --- Contact form routing ---
CONTACT_TO_EMAIL=hello@bitcoinforthearts.org
# CONTACT_FROM_EMAIL=hello@bitcoinforthearts.org
# CONTACT_SUBJECT_PREFIX=Website contact

# --- SMTP fallback (optional; used if Resend is unavailable) ---
# CONTACT_SMTP_USER=hello@bitcoinforthearts.org
# CONTACT_SMTP_PASS=app-password-here
# CONTACT_SMTP_HOST=smtppro.zoho.com
# CONTACT_SMTP_PORT=465
# CONTACT_SMTP_SECURE=true

# --- Grants ---
GRANTS_TO_EMAIL=grants@bitcoinforthearts.org
# GRANTS_FROM_EMAIL=grants@bitcoinforthearts.org
# GRANTS_SMTP_USER=grants@bitcoinforthearts.org
# GRANTS_SMTP_PASS=app-password-here
# GRANTS_SMTP_HOST=smtppro.zoho.com
# GRANTS_SMTP_PORT=465
# GRANTS_SMTP_SECURE=true

# --- Reviewer share links ---
REVIEW_LINK_SECRET=change-me-very-long-random-string

# --- Cloudflare Turnstile (spam protection) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAA....
TURNSTILE_SECRET_KEY=0x4AAAAA....
# Optional debug:
# NEXT_PUBLIC_TURNSTILE_DEBUG=1
# TURNSTILE_DEBUG=1

# --- BTCPay Server (donations) ---
# Public HTTPS URL (not .local or .onion)
BTCPAY_URL=https://donate.bitcoinforthearts.org
# Public HTTPS URL exposed to the browser (used to build /plan-checkout/... links)
NEXT_PUBLIC_BTCPAY_URL=https://donate.bitcoinforthearts.org
# Store API key (create in BTCPay Server > API Keys)
BTCPAY_API_KEY=btcpay_api_key_here
# Store ID (BTCPay Server > Stores > Settings)
BTCPAY_STORE_ID=btcpay_store_id_here

# --- BTCPay Subscriptions kill-switch ---
# Set to "1" to hide all "Subscribe with Bitcoin" buttons on /donate/monthly
# and fall back to the one-time invoice flow. Use this if Plan Checkouts are
# returning 404 / 500 errors from BTCPay Server.
# NEXT_PUBLIC_BTCPAY_SUBSCRIPTIONS_DISABLED=1

# --- BTCPay Subscription Plan IDs ---
# Each value is the plancheckout_xxx ID from BTCPay Server
# (Stores > [your store] > Subscriptions > Plans > [plan] > "Plan Checkout link").
# Format MUST be: plancheckout_XXXXXXXXXXXXXXXX
# Leave any blank to fall back to a one-time Bitcoin invoice for that tier.
# NEXT_PUBLIC_BTCPAY_MONTHLY_5_PLAN=plancheckout_XXX
# NEXT_PUBLIC_BTCPAY_ANNUAL_55_PLAN=plancheckout_XXX
# NEXT_PUBLIC_BTCPAY_MONTHLY_11_PLAN=plancheckout_XXX
# NEXT_PUBLIC_BTCPAY_ANNUAL_121_PLAN=plancheckout_XXX
# NEXT_PUBLIC_BTCPAY_MONTHLY_21_PLAN=plancheckout_XXX
# NEXT_PUBLIC_BTCPAY_ANNUAL_231_PLAN=plancheckout_XXX
# NEXT_PUBLIC_BTCPAY_MONTHLY_51_PLAN=plancheckout_XXX
# NEXT_PUBLIC_BTCPAY_ANNUAL_561_PLAN=plancheckout_XXX
# NEXT_PUBLIC_BTCPAY_MONTHLY_101_PLAN=plancheckout_XXX
# NEXT_PUBLIC_BTCPAY_ANNUAL_1111_PLAN=plancheckout_XXX

# --- Volunteer signup routing ---
VOLUNTEER_TO_EMAIL=volunteers@bitcoinforthearts.org
# VOLUNTEER_FALLBACK_TO_EMAIL=grants@bitcoinforthearts.org
# VOLUNTEER_FROM_EMAIL=volunteers@bitcoinforthearts.org

# --- Education waitlist routing ---
EDU_TO_EMAIL=education@bitcoinforthearts.org
# EDU_FALLBACK_TO_EMAIL=grants@bitcoinforthearts.org
# EDU_FROM_EMAIL=education@bitcoinforthearts.org

# --- Feedback routing ---
FEEDBACK_TO_EMAIL=feedback@bitcoinforthearts.org
# FEEDBACK_FROM_EMAIL=feedback@bitcoinforthearts.org

# --- Governance / nominations routing ---
GOVERNANCE_TO_EMAIL=trustees@bitcoinforthearts.org
# GOVERNANCE_FROM_EMAIL=trustees@bitcoinforthearts.org
# BOARD_NOMINATION_TO_EMAIL=trustees@bitcoinforthearts.org

# --- Misc ---
# NEXT_PUBLIC_SHOW_HOME_INTRO=0

# --- Artist Hub (Nostr + Lightning, fully client-side) ---
# Comma-separated relay list for the hub (built into the static bundle):
# PUBLIC_BFTA_RELAYS=wss://nostr.wine,wss://purplepag.es,wss://relay.damus.io
#
# BFTA admin npub for publishing/reading Featured Artists (NIP-51 curated set):
# PUBLIC_BFTA_ADMIN_NPUB=npub1...

